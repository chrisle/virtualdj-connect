{
  "name": "virtualdj-connect",
  "version": "1.1.1",
  "description": "Real-time VirtualDJ track metadata for Node — M3U history watcher plus a Network Control client with per-deck data, on-air detection, and sandbox awareness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisle/virtualdj-connect.git"
  },
  "homepage": "https://github.com/chrisle/virtualdj-connect",
  "bugs": {
    "url": "https://github.com/chrisle/virtualdj-connect/issues"
  },
  "private": false,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --build tsconfig.json",
    "watch": "tsc --build tsconfig.json -w",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "strict-event-emitter-types": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
